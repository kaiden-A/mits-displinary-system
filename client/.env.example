# Copy to .env and fill in real values (never commit .env)

# Zitadel (staff auth)
ZITADEL_ISSUER=https://your-instance.us1.zitadel.cloud
ZITADEL_CLIENT_ID=123456789012345678
# Members of this org may sign in (org id in Zitadel console → organization settings URL)
ZITADEL_ALLOWED_ORG_ID=123456789012345678
# Optional: request a specific project's roles in the token (adds the project to the
# token audience and requests its roles claim). Set this to your Zitadel project id.
ZITADEL_PROJECT_ID=

# Used to sign/verify the app's own session cookie JWT (HS256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=change-me

# FastAPI backend
API_URL=http://localhost:8000

# Shared secret for pengawas session JWT (mirror of server APP_SECRET)
APP_SECRET=change-me