# Copy to .env and fill in real values (never commit .env)

# Postgres (Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Zitadel (staff auth)
ZITADEL_ISSUER=https://your-instance.us1.zitadel.cloud
ZITADEL_JWKS_URI=https://your-instance.us1.zitadel.cloud/oauth/v2/keys
ZITADEL_AUDIENCE=123456789012345678
ZITADEL_REQUIRED_ROLE=

# Email API (push notifications)
EMAIL_API=https://api.motionukict.com
API_KEY=your-email-api-key

# Pengawas local session signing secret (HS256) — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=change-me
PENGAWAS_SESSION_MINUTES=15
PENGAWAS_MAX_FAILED=5
PENGAWAS_LOCK_MINUTES=15
CORS_ORIGINS=http://localhost:3000